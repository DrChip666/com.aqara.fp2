      "name": {
        "en": "Presence Sensor FP2",
        "da": "Tilstedeværelsessensor FP2"
      },
      "class": "sensor",
      "capabilities": [
        "alarm_motion",
        "measure_luminance"
      ],
      "capabilitiesOptions": {
        "alarm_motion": {
          "title": {
            "en": "Presence",
            "da": "Tilstedeværelse"
          },
          "insightsTitleTrue": {
            "en": "Presence detected",
            "da": "Tilstedeværelse registreret"
