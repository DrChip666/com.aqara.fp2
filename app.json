  "flow": {
    "triggers": [
      {
        "id": "zone_occupied",
        "title": {
          "en": "Presence detected in a zone",
          "da": "Tilstedeværelse registreret i en zone"
        },
        "titleFormatted": {
          "en": "Presence detected in [[zone]]",
          "da": "Tilstedeværelse registreret i [[zone]]"
        },
        "hint": {
          "en": "Zones are the detection areas you set up in the Aqara Home app.",
          "da": "Zoner er de registreringsområder, du har oprettet i Aqara Home-appen."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=fp2"
          },
          {
            "name": "zone",
            "type": "autocomplete",
            "title": {
              "en": "Zone",
              "da": "Zone"
            },
            "placeholder": {
              "en": "Choose a zone",
              "da": "Vælg en zone"
            }
          }
        ],
        "tokens": [
          {
            "name": "zone",
            "type": "string",
            "title": {
              "en": "Zone",
              "da": "Zone"
            },
            "example": {
              "en": "Sofa",
              "da": "Sofa"
            }
          }
        ]
      },
      {
        "id": "zone_vacant",
        "title": {
          "en": "A zone became empty",
          "da": "En zone blev tom"
        },
        "titleFormatted": {
          "en": "[[zone]] became empty",
          "da": "[[zone]] blev tom"
        },
        "hint": {
          "en": "Zones are the detection areas you set up in the Aqara Home app.",
          "da": "Zoner er de registreringsområder, du har oprettet i Aqara Home-appen."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=fp2"
          },
          {
            "name": "zone",
            "type": "autocomplete",
            "title": {
              "en": "Zone",
              "da": "Zone"
            },
            "placeholder": {
              "en": "Choose a zone",
              "da": "Vælg en zone"
            }
          }
        ],
        "tokens": [
          {
            "name": "zone",
            "type": "string",
            "title": {
              "en": "Zone",
              "da": "Zone"
            },
            "example": {
              "en": "Sofa",
              "da": "Sofa"
            }
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "zone_is_occupied",
        "title": {
          "en": "Someone !{{is|isn't}} in a zone",
          "da": "Der er !{{nogen|ingen}} i en zone"
        },
        "titleFormatted": {
          "en": "Someone !{{is|isn't}} in [[zone]]",
          "da": "Der er !{{nogen|ingen}} i [[zone]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=fp2"
          },
          {
            "name": "zone",
            "type": "autocomplete",
            "title": {
              "en": "Zone",
              "da": "Zone"
            },
            "placeholder": {
              "en": "Choose a zone",
              "da": "Vælg en zone"
            }
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Presence Sensor FP2",
        "da": "Tilstedeværelsessensor FP2"
      },
      "class": "sensor",
      "capabilities": [
        "alarm_motion",
        "measure_luminance"
      ],
      "capabilitiesOptions": {
        "alarm_motion": {
          "title": {
            "en": "Presence",
            "da": "Tilstedeværelse"
          },
          "insightsTitleTrue": {
            "en": "Presence detected",
            "da": "Tilstedeværelse registreret"
          },
          "insightsTitleFalse": {
            "en": "Room empty",
            "da": "Rummet er tomt"
          }
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "discovery": "aqara_fp2",
      "images": {
        "small": "/drivers/fp2/assets/images/small.png",
        "large": "/drivers/fp2/assets/images/large.png",
        "xlarge": "/drivers/fp2/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "options": {
            "singular": true
          },
          "navigation": {
            "next": "pincode"
          }
        },
        {
          "id": "pincode",
          "template": "pincode",
          "options": {
            "title": {
              "en": "Enter the HomeKit code",
              "da": "Indtast HomeKit-koden"
            },
            "hint": {
              "en": "Enter the 8-digit code printed above the QR code on the FP2. If the FP2 is in Apple Home, remove it there first and restart the FP2.",
              "da": "Indtast den 8-cifrede kode, der står over QR-koden på FP2. Hvis FP2 er i Apple Home, så fjern den der først og genstart FP2."
            },
            "type": "number",
            "length": 8
          },
          "navigation": {
            "prev": "list_devices",
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "pincode",
          "template": "pincode",
          "options": {
            "title": {
              "en": "Pair the FP2 again",
              "da": "Par FP2 igen"
            },
            "hint": {
              "en": "Enter the 8-digit HomeKit code from the FP2. If pairing is refused, reset the FP2's HomeKit connection in the Aqara Home app first.",
              "da": "Indtast den 8-cifrede HomeKit-kode fra FP2. Hvis parringen afvises, så nulstil FP2's HomeKit-forbindelse i Aqara Home-appen først."
            },
            "type": "number",
            "length": 8
          },
          "navigation": {
            "next": "done"
          }
        },
        {
          "id": "done",
          "template": "done"
        }
      ],
      "id": "fp2",
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Zones",
            "da": "Zoner"
          },
          "children": [
            {
              "id": "fp2_zone_names",
              "type": "textarea",
              "label": {
                "en": "Zone names",
                "da": "Zonenavne"
              },
              "value": "",
              "hint": {
                "en": "One name per line, in the same order as the zones on the device. Leave a line empty to use the name from the FP2. Renaming does not affect your Flows.",
                "da": "Ét navn pr. linje, i samme rækkefølge som zonerne på enheden. Lad en linje stå tom for at bruge navnet fra FP2. Omdøbning påvirker ikke dine Flows."
              }
            }
          ]
        }
      ]
    }
  ],
  "discovery": {
    "aqara_fp2": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "hap",
        "protocol": "tcp"
      },
      "id": "{{txt.id}}",
      "conditions": [
        [
          {
            "field": "txt.md",
            "match": {
              "type": "regex",
              "value": "FP2|PS-S02"
            }
          }
        ],
        [
          {
            "field": "name",
            "match": {
              "type": "regex",
              "value": "FP2"
            }
          }
        ]
      ]
    }
  }
}