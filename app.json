      "discovery": "aqara_fp2",
      "images": {
        "small": "/drivers/fp2_zone/assets/images/small.png",
        "large": "/drivers/fp2_zone/assets/images/large.png",
        "xlarge": "/drivers/fp2_zone/assets/images/xlarge.png"
